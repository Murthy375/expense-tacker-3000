								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "- so the 1st time the user creates a profile, the data will be processed"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "  and stored in the DB "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "- then stored in Redis(cache/in memory store)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "- next time when user want user info(hit GET /user API route) then Redis is first"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "  checked if there is data then serve it else we have stored in DB(source of truth) serve that."
								}
							]
						}
					]
				}
			},
