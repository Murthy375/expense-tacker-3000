							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Q] how am I gonna build the front-endz?, cuz I really suck at it."
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "A] I got to use AI, but it has limits, but before that I need "
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "    to focus on the UI/UX part. designing a UI with stich, 🫡"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "    plus I'll build the front-end later, if needed."
								}
							]
						},
						{
							"type": "paragraph"
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Q] How will Redis help my app be better? (other than it stored my "
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "    user's info and avoids an expensive DB call and it's fast)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "A] "
								}
							]
						}
					]
				}
			}
		},
